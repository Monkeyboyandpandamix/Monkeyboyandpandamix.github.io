  "project-nextgen-ids": {
    "category": "software",
    "chips": [
      "Java",
      "Next.js",
      "OSHI",
      "JFreeChart",
      "IDS"
    ],
    "dateLine": "Oct 2025 - Present",
    "detailHtml": "<p>Developed a multi-component intrusion detection system featuring a Java-based security analytics dashboard with a prototype Next.js web interface for future web-based monitoring.</p>\n          <p>The platform aggregates and correlates security events from system resources, network traffic, file-system activity, and threat intelligence analysis modules for real-time visibility.</p>\n          <p>System Monitor tracks CPU, memory, and processes via OSHI telemetry. Network Monitor captures/analyzes traffic to detect unusual behavior. File Monitor tracks file changes with suspicious-pattern scoring and quarantine support.</p>\n          <p>Dashboard was built with Java Swing and JFreeChart, with real-time tabs/charts/event logs. An event-driven architecture using BlockingQueue allows modules to feed a centralized analytics engine with filtering/search/prioritization/historical analysis.</p>\n\n          <div class=\"media-grid\">\n            <figure class=\"media-item\"><img loading=\"lazy\" decoding=\"async\" src=\"./assets/media/projects/ids/ids-3-gui.jpeg\" alt=\"ids 3 gui\"><figcaption>ids 3 gui</figcaption></figure>\n            <figure class=\"media-item\"><img loading=\"lazy\" decoding=\"async\" src=\"./assets/media/projects/ids/ids-nextgen-software-based-intrusion-detection.jpeg\" alt=\"ids nextgen software based intrusion detection\"><figcaption>ids nextgen software based intrusion detection</figcaption></figure>\n            <figure class=\"media-item\"><img loading=\"lazy\" decoding=\"async\" src=\"./assets/media/projects/ids/ids2-network-analysis-and-metrics.jpeg\" alt=\"ids2 network analysis and metrics\"><figcaption>ids2 network analysis and metrics</figcaption></figure>\n            <figure class=\"media-item\"><img loading=\"lazy\" decoding=\"async\" src=\"./assets/media/projects/ids/ids4-code.jpeg\" alt=\"ids4 code\"><figcaption>ids4 code</figcaption></figure>\n          </div>",
    "meta": "",
    "orderIndex": 998,
    "slug": "project-nextgen-ids",
    "summaryHtml": "<p>Multi-module IDS architecture with Java analytics dashboard and web interface prototype.</p>",
    "timelineDateLabel": "October 2025 - Present",
    "timelineEnabled": true,
    "timelineSortMs": 1759291200000,
    "title": "NextGen Software-Based Intrusion Detection"
  },
