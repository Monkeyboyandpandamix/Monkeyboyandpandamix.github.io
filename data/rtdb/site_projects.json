  "project-ctis-lab-deployment": {
    "category": "hardware",
    "chips": [
      "Raspberry Pi",
      "Active Directory",
      "Proxmox",
      "Windows Server",
      "Enterprise Lab"
    ],
    "dateLine": "Aug 2024 - Dec 2025",
    "detailHtml": "<p>Led complete deployment/restoration of CTIS computer lab infrastructure from non-functional state to fully operational enterprise-style environment.</p>\n          <p>Diagnosed/repaired/reconfigured Dell PowerEdge and HP servers; built Proxmox cluster for virtualized domain services.</p>\n          <p>Designed/deployed AD DS, DNS, DHCP, Group Policy, with primary and backup domain controllers.</p>\n          <p>Deployed ~12 domain-joined workstations with reimaging, drivers, software, and domain integration.</p>\n          <p>Built accounts/security groups/permissions for controlled access and system security.</p>\n          <p>Installed rack infrastructure, power/network organization, Ethernet cabling, and tested network stability.</p>\n          <p>Worked with IT to deploy/configure wireless AP and secure domain-managed connectivity.</p>\n          <p>Performed extensive hardware diagnostics and restored previously unusable systems.</p>\n          <p>Strong teamwork with partner enabled successful lab build and deployment.</p>\n\n          <div class=\"media-grid\">\n            <figure class=\"media-item\"><img loading=\"lazy\" decoding=\"async\" src=\"./assets/media/projects/ctis-lab/ctis-lab-infrastructure-deployment-couple-of-desktops.jpeg\" alt=\"ctis lab infrastructure deployment couple of desktops\"><figcaption>ctis lab infrastructure deployment couple of desktops</figcaption></figure>\n            <figure class=\"media-item\"><img loading=\"lazy\" decoding=\"async\" src=\"./assets/media/projects/ctis-lab/ctis-lab-infrastructure-deployment-server-setup1.jpeg\" alt=\"ctis lab infrastructure deployment server setup1\"><figcaption>ctis lab infrastructure deployment server setup1</figcaption></figure>\n            <figure class=\"media-item\"><img loading=\"lazy\" decoding=\"async\" src=\"./assets/media/projects/ctis-lab/ctis-lab-infrastructure-deployment-settingup-lab-access-points.jpeg\" alt=\"ctis lab infrastructure deployment settingup lab access points\"><figcaption>ctis lab infrastructure deployment settingup lab access points</figcaption></figure>\n          </div>",
    "meta": "Associated with Guilford College",
    "orderIndex": 993,
    "slug": "project-ctis-lab-deployment",
    "summaryHtml": "<p>Enterprise lab rebuild with virtualization, AD domain services, and secure workstation deployment.</p>",
    "timelineDateLabel": "August 2024 - December 2025",
    "timelineEnabled": true,
    "timelineSortMs": 1722484800000,
    "title": "CTIS Lab Infrastructure Deployment \u2699 - Guilford College"
  },
  "project-file-signature-analyzer": {
    "category": "software",
    "chips": [
      "Java",
      "Forensics",
      "Hashing",
      "macOS/Windows"
    ],
    "dateLine": "Feb 2025 - Mar 2025",
    "detailHtml": "<p>Developed cybersecurity/digital forensics tool that detects fake/renamed files by binary signatures rather than extensions.</p>\n          <p>Verifies integrity with MD5/SHA-1/SHA-256 and extracts metadata/structure/system properties.</p>\n          <p>Includes hex-level viewing/search, entropy and MIME analysis, structural validation, and anomaly detection.</p>\n          <p>Also performs image steganography analysis and hidden data extraction for forensic reporting.</p>\n          <p>Runs on macOS and Windows; fully implemented in Java.</p>\n\n          <div class=\"media-grid\">\n            <figure class=\"media-item\"><img loading=\"lazy\" decoding=\"async\" src=\"./assets/media/projects/file-signature-analyzer/file-signature-analyzer-file-header-signiture.jpeg\" alt=\"file signature analyzer file header signiture\"><figcaption>file signature analyzer file header signiture</figcaption></figure>\n            <figure class=\"media-item\"><img loading=\"lazy\" decoding=\"async\" src=\"./assets/media/projects/file-signature-analyzer/file-signature-analyzer-full-report-page.jpeg\" alt=\"file signature analyzer full report page\"><figcaption>file signature analyzer full report page</figcaption></figure>\n            <figure class=\"media-item\"><img loading=\"lazy\" decoding=\"async\" src=\"./assets/media/projects/file-signature-analyzer/file-signature-analyzer-hexviewer.jpeg\" alt=\"file signature analyzer hexviewer\"><figcaption>file signature analyzer hexviewer</figcaption></figure>\n            <figure class=\"media-item\"><img loading=\"lazy\" decoding=\"async\" src=\"./assets/media/projects/file-signature-analyzer/file-signature-analyzer-metadata-extractor.jpeg\" alt=\"file signature analyzer metadata extractor\"><figcaption>file signature analyzer metadata extractor</figcaption></figure>\n            <figure class=\"media-item\"><img loading=\"lazy\" decoding=\"async\" src=\"./assets/media/projects/file-signature-analyzer/file-signature-analyzer-stenegraphy-detector.jpeg\" alt=\"file signature analyzer stenegraphy detector\"><figcaption>file signature analyzer stenegraphy detector</figcaption></figure>\n          </div>",
    "meta": "Associated with Guilford College",
    "orderIndex": 989,
    "slug": "project-file-signature-analyzer",
    "summaryHtml": "<p>Forensics utility for file signature verification, hashing, metadata extraction, and anomaly checks.</p>",
    "timelineDateLabel": "February 2025 - March 2025",
    "timelineEnabled": true,
    "timelineSortMs": 1738386000000,
    "title": "File Signature Analyzer"
  },
  "project-gratitude-afropix26": {
    "category": "software",
    "chips": [
      "1st Place - AfroPix26",
      "Community Platform",
      "Map-first UX"
    ],
    "dateLine": "Feb 2026 - Feb 2026",
    "detailHtml": "<p>Gratitude is a neighborhood discovery platform designed to make local support and opportunities easier to find, trust, and act on.</p>\n          <p>The app organizes content into tabs for events, volunteer opportunities, food banks/donation resources, community organizations, help &amp; support services, nearby connections, and civics/politics.</p>\n          <p>Experience is map-first and filter-driven (distance/relevance/date) with list/map/split views, source attribution, confidence indicators, and deduplication safeguards.</p>\n          <p>Platform remains useful without AI via scraper/API pipelines and rule-based categorization; AI is an enhancement layer for structuring/classification/gap filling.</p>\n          <p>Includes built-in AI assistance and language customization.</p>\n\n          <div class=\"media-grid\">\n            <figure class=\"media-item\"><video controls preload=\"metadata\" src=\"./assets/media/projects/gratitude/afropix-application-into-and-walkthrough.mp4\"></video><figcaption>afropix application into and walkthrough</figcaption></figure>\n            <figure class=\"media-item\"><img loading=\"lazy\" decoding=\"async\" src=\"./assets/media/projects/gratitude/afropix26-group-pic.jpeg\" alt=\"afropix26 group pic\"><figcaption>afropix26 group pic</figcaption></figure>\n            <figure class=\"media-item\"><video controls preload=\"metadata\" src=\"./assets/media/projects/gratitude/afropix26-project-walkthou.mp4\"></video><figcaption>afropix26 project walkthou</figcaption></figure>\n            <figure class=\"media-item\"><img loading=\"lazy\" decoding=\"async\" src=\"./assets/media/projects/gratitude/gratitude-application-logo-for-devpost.jpeg\" alt=\"gratitude application logo for devpost\"><figcaption>gratitude application logo for devpost</figcaption></figure>\n          </div>",
    "meta": "",
    "orderIndex": 995,
    "slug": "project-gratitude-afropix26",
    "summaryHtml": "<p>Community discovery platform for trusted local resources, support, and civic engagement.</p>",
    "timelineDateLabel": "February 2026",
    "timelineEnabled": true,
    "timelineSortMs": 1769922000000,
    "title": "Gratitude (AfroPix26)"
  },
  "project-guardiapass-hackncstate26": {
    "category": "software",
    "chips": [
      "3rd Place - Agency Track",
      "Encryption",
      "Browser Security"
    ],
    "dateLine": "Feb 2026 - Feb 2026",
    "detailHtml": "<p>GuardiaPass combines encrypted credential management, browser protection, and intelligent assistants in one system.</p>\n          <p>It secures passwords, identities, and sensitive media with local encryption, then extends protection into the browser with autofill, phishing/domain checks, breach intelligence, and suspicious-email filtering.</p>\n          <p>Includes multiple AI assistants: in-app Security Advisor, extension page assistants for live site analysis, and contextual tools for password generation/strength/risk explanations.</p>\n          <p>Accessibility includes read-aloud support. Architecture includes local-first secure storage, server-side API proxying for key protection, real-time telemetry, trust checks, and assistant-driven workflows.</p>\n          <p>In short, GuardiaPass is an AI-powered security command center: protect, verify, assist, and educate from one place.</p>\n          <div class=\"video-embed\">\n            <iframe src=\"https://www.youtube.com/embed/2eVS3mA3SXk\" title=\"GUARDIAPASS (HackNC State26) walkthrough\" loading=\"lazy\" allow=\"accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share\" referrerpolicy=\"strict-origin-when-cross-origin\" allowfullscreen></iframe>\n          </div>\n          <div class=\"media-grid\">\n            <figure class=\"media-item\"><img loading=\"lazy\" decoding=\"async\" src=\"./assets/media/projects/guardiapass/gaurdiapass-9-accessibility-and-settings.jpeg\" alt=\"gaurdiapass 9 accessibility and settings\"><figcaption>gaurdiapass 9 accessibility and settings</figcaption></figure>\n            <figure class=\"media-item\"><img loading=\"lazy\" decoding=\"async\" src=\"./assets/media/projects/guardiapass/gaurdiapass1-login-screen.jpeg\" alt=\"gaurdiapass1 login screen\"><figcaption>gaurdiapass1 login screen</figcaption></figure>\n            <figure class=\"media-item\"><img loading=\"lazy\" decoding=\"async\" src=\"./assets/media/projects/guardiapass/gaurdiapass2-chrome-extension.jpeg\" alt=\"gaurdiapass2 chrome extension\"><figcaption>gaurdiapass2 chrome extension</figcaption></figure>\n            <figure class=\"media-item\"><img loading=\"lazy\" decoding=\"async\" src=\"./assets/media/projects/guardiapass/gaurdiapass3-main-page-with-password-id-and-photo-vault.jpeg\" alt=\"gaurdiapass3 main page with password id and photo vault\"><figcaption>gaurdiapass3 main page with password id and photo vault</figcaption></figure>\n            <figure class=\"media-item\"><img loading=\"lazy\" decoding=\"async\" src=\"./assets/media/projects/guardiapass/gaurdiapass4-userid-darkweb-scanner.jpeg\" alt=\"gaurdiapass4 userid darkweb scanner\"><figcaption>gaurdiapass4 userid darkweb scanner</figcaption></figure>\n            <figure class=\"media-item\"><img loading=\"lazy\" decoding=\"async\" src=\"./assets/media/projects/guardiapass/gaurdiapass5-website-ai-verifier.jpeg\" alt=\"gaurdiapass5 website ai verifier\"><figcaption>gaurdiapass5 website ai verifier</figcaption></figure>\n            <figure class=\"media-item\"><img loading=\"lazy\" decoding=\"async\" src=\"./assets/media/projects/guardiapass/gaurdiapass6-cyber-academy-for-education.jpeg\" alt=\"gaurdiapass6 cyber academy for education\"><figcaption>gaurdiapass6 cyber academy for education</figcaption></figure>\n            <figure class=\"media-item\"><img loading=\"lazy\" decoding=\"async\" src=\"./assets/media/projects/guardiapass/gaurdiapass7-activity-analytics.jpeg\" alt=\"gaurdiapass7 activity analytics\"><figcaption>gaurdiapass7 activity analytics</figcaption></figure>\n            <figure class=\"media-item\"><img loading=\"lazy\" decoding=\"async\" src=\"./assets/media/projects/guardiapass/gaurdiapass8-network-traffic.jpeg\" alt=\"gaurdiapass8 network traffic\"><figcaption>gaurdiapass8 network traffic</figcaption></figure>\n            <figure class=\"media-item\"><img loading=\"lazy\" decoding=\"async\" src=\"./assets/media/projects/guardiapass/gaurdiapss10-active-email-checker-with-probability-scores.jpeg\" alt=\"gaurdiapss10 active email checker with probability scores\"><figcaption>gaurdiapss10 active email checker with probability scores</figcaption></figure>\n            <figure class=\"media-item\"><img loading=\"lazy\" decoding=\"async\" src=\"./assets/media/projects/guardiapass/hackncstate-group-pic.jpeg\" alt=\"hackncstate group pic\"><figcaption>hackncstate group pic</figcaption></figure>\n            <figure class=\"media-item\"><img loading=\"lazy\" decoding=\"async\" src=\"./assets/media/projects/guardiapass/hackncstate-pic-of-perticipents-working.jpeg\" alt=\"hackncstate pic of perticipents working\"><figcaption>hackncstate pic of perticipents working</figcaption></figure>\n            <figure class=\"media-item\"><img loading=\"lazy\" decoding=\"async\" src=\"./assets/media/projects/guardiapass/hackncstate26-devpost-win-confirmation-email.jpeg\" alt=\"hackncstate26 devpost win confirmation email\"><figcaption>hackncstate26 devpost win confirmation email</figcaption></figure>\n            <figure class=\"media-item\"><img loading=\"lazy\" decoding=\"async\" src=\"./assets/media/projects/guardiapass/hackncstate26-pic-of-a-workshop.jpeg\" alt=\"hackncstate26 pic of a workshop\"><figcaption>hackncstate26 pic of a workshop</figcaption></figure>\n          </div>",
