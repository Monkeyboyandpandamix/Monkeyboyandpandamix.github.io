    "summaryHtml": "<p>Raspberry Pi smart doorbell with camera/audio and remote Jitsi communication workflow.</p>",
    "timelineDateLabel": "October 2023 - December 2023",
    "timelineEnabled": true,
    "timelineSortMs": 1696132800000,
